# Variables attendues par l'application — aucune valeur réelle ici.
# Seul le préfixe VITE_ est exposé au navigateur (cf. ARCHITECTURE.md section 9).
# La clé service_role Supabase ne doit JAMAIS figurer ici : elle contourne le RLS.
#
# Développement : valeurs réelles dans .env.development.local (non commité).
# Production : valeurs réelles uniquement dans les variables d'environnement
# Netlify — jamais dans un fichier de ce dépôt.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé service_role : jamais préfixée VITE_ (CLAUDE.md §7), utilisée uniquement
# par scripts/create-user.mjs, jamais importée par le bundle client.
# À récupérer manuellement : dashboard Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Origine de l'app (sans slash final), utilisée par scripts/create-user.mjs
# pour construire le lien de l'email d'invitation (redirectTo). En local :
# http://localhost:5173. En production : l'URL Netlify du site.
#
# La fonction Edge invite-user (supabase/functions/invite-user/) a besoin de
# la MÊME valeur pour construire son lien /activation — mais comme secret de
# la fonction (`supabase secrets set SITE_URL=...`), jamais lu depuis ce
# fichier .env local (une fonction déployée n'y a pas accès).
SITE_URL=

# --- Observabilité (PostHog Cloud EU) — cf. docs/OBSERVABILITE.md ---
# Clé projet (phc_…) : publique par conception, seule clé PostHog autorisée en
# VITE_. À définir sur Netlify avec la portée « Production » uniquement.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Dev : rien n'est envoyé (PostHog n'est actif qu'en build de production).

# Envoi des source maps (étape de build uniquement — secrets Netlify/CI, JAMAIS
# préfixés VITE_ : la clé API personnelle donne accès au projet PostHog).
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://eu.posthog.com

# --- Notifications push (specs/mob-notifications.md) ---
# Clé VAPID PUBLIQUE uniquement (générer la paire : npx web-push generate-vapid-keys).
VITE_VAPID_PUBLIC_KEY=
# La clé VAPID PRIVÉE (VAPID_PRIVATE_KEY), VAPID_PUBLIC_KEY, VAPID_SUBJECT,
# PUSH_DISPATCH_SECRET et CLUB_TIME_ZONE sont des secrets de l'Edge Function
# send-push (`supabase secrets set ...`) : JAMAIS préfixés VITE_, jamais ici.
