# Variables attendues par l'application — aucune valeur réelle ici.
# Seul le préfixe VITE_ est exposé au navigateur (cf. ARCHITECTURE.md section 9).
# La clé service_role Supabase ne doit JAMAIS figurer ici : elle contourne le RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé service_role : jamais préfixée VITE_ (CLAUDE.md §7), utilisée uniquement
# par scripts/create-user.mjs, jamais importée par le bundle client.
# À récupérer manuellement : dashboard Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
