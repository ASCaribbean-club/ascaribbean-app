# Valeurs factices pour l'environnement de test (mode "test" de Vitest).
# supabase-client.ts crée le client Supabase au chargement du module — un
# vi.mock() sur un hook qui en dépend transitivement (di/container.ts)
# importe quand même ce module pour l'automock, donc createClient() doit
# réussir même quand aucun test n'appelle réellement Supabase. Aucune valeur
# réelle ici, jamais utilisées pour un vrai appel réseau.

VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
